---
/**
 * src/pages/[lang]/index.astro
 * Home page for each locale: /en/, /pt/, /es/
 * Lists all articles for that locale with the ArticleCard component.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import { SUPPORTED_LOCALES, SITE_URL, type SupportedLocale } from '../../i18n/constants';

export async function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);

const allPosts = await getCollection('blog', (post) => {
  return post.data.locale === lang && !post.data.draft;
});

allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Hreflang for home pages — point to each locale's home
const hreflangAlternates = [
  ...SUPPORTED_LOCALES.map((locale) => ({
    hreflang: locale,
    href: `${SITE_URL}/${locale}/`,
  })),
  { hreflang: 'x-default', href: `${SITE_URL}/en/` },
];
---

<BaseLayout
  title={t('nav.home')}
  description={t('site.tagline')}
  lang={lang}
  hreflangAlternates={hreflangAlternates}
  canonicalUrl={`${SITE_URL}/${lang}/`}
>
  <Header slot="header" lang={lang} />

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <div class="hero__badge">
          <span>✦</span>
          <span>Tech &amp; Productivity</span>
        </div>
        <h1 class="hero__title">{t('home.hero.title')}</h1>
        <p class="hero__subtitle">{t('home.hero.subtitle')}</p>
        <a href="#articles" class="hero__cta">
          {t('home.hero.cta')}
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 3V15M4 10L9 15L14 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- AdSense Slot — top banner (placeholder until account is approved) -->
  <div class="container" style="margin-top: 2rem;">
    <div class="adsense-slot" aria-hidden="true">Advertisement</div>
  </div>

  <!-- Articles Grid -->
  <section class="articles" id="articles">
    <div class="container">
      <h2 class="articles__heading">{t('home.latestArticles')}</h2>

      {allPosts.length > 0 ? (
        <div class="articles__grid">
          {allPosts.map((post) => (
            <ArticleCard post={post} lang={lang} />
          ))}
        </div>
      ) : (
        <p class="articles__empty">No articles yet. Check back soon!</p>
      )}
    </div>
  </section>

  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 5rem 0 4rem;
    text-align: center;
    background: linear-gradient(
      180deg,
      var(--color-accent-light) 0%,
      transparent 100%
    );
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hero__content {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    background: white;
    border: 1px solid var(--color-border);
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }

  .hero__title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
  }

  .hero__subtitle {
    font-size: 1.075rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 540px;
    margin: 0;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent);
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 14px rgb(99 102 241 / 0.35);
  }

  .hero__cta:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgb(99 102 241 / 0.45);
    color: white;
  }

  /* ── Articles ── */
  .articles {
    padding: 4rem 0 3rem;
  }

  .articles__heading {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
    color: var(--color-text-primary);
  }

  .articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .articles__empty {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
