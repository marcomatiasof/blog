---
/**
 * src/pages/[lang]/index.astro
 * Home page for each locale: /en/, /pt/, /es/
 * Incorporates James Clear hero newsletter focus, Zen Habits aesthetic, and The Points Guy card grid.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import { SUPPORTED_LOCALES, SITE_URL, type SupportedLocale } from '../../i18n/constants';

export async function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);

const allPosts = await getCollection('blog', (post) => {
  return post.data.locale === lang && !post.data.draft;
});

allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Hreflang for home pages
const hreflangAlternates = [
  ...SUPPORTED_LOCALES.map((locale) => ({
    hreflang: locale,
    href: `${SITE_URL}/${locale}/`,
  })),
  { hreflang: 'x-default', href: `${SITE_URL}/en/` },
];
---

<BaseLayout
  title={t('nav.home')}
  description={t('site.tagline')}
  lang={lang}
  hreflangAlternates={hreflangAlternates}
  canonicalUrl={`${SITE_URL}/${lang}/`}
>
  <Header slot="header" lang={lang} />

  <!-- Hero Section (James Clear / Zen Habits inspired) -->
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <h1 class="hero__title">{t('home.hero.title')}</h1>
        <p class="hero__subtitle">{t('home.hero.subtitle')}</p>
        
        <!-- Hero Newsletter Subscription Box -->
        <div class="hero__newsletter">
          <NewsletterBox lang={lang} variant="hero" />
        </div>
      </div>
    </div>
  </section>

  <!-- AdSense Slot — top banner (placeholder) -->
  <div class="container" style="margin-top: 2.5rem;">
    <div class="adsense-slot" aria-hidden="true">Advertisement</div>
  </div>

  <!-- Articles Section (The Points Guy / James Clear grid) -->
  <section class="articles" id="articles">
    <div class="container">
      <div class="articles__header">
        <h2 class="articles__heading">{t('home.latestArticles')}</h2>
        <span class="articles__count">{allPosts.length} {allPosts.length === 1 ? 'essay' : 'essays'}</span>
      </div>

      {allPosts.length > 0 ? (
        <div class="articles__grid">
          {allPosts.map((post) => (
            <ArticleCard post={post} lang={lang} />
          ))}
        </div>
      ) : (
        <p class="articles__empty">No articles published yet.</p>
      )}
    </div>
  </section>

  <!-- Bottom Newsletter CTA Section -->
  <section class="bottom-newsletter">
    <div class="container">
      <NewsletterBox lang={lang} variant="card" />
    </div>
  </section>

  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 4rem 0 3.5rem;
    background: linear-gradient(180deg, #f5f5f0 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__content {
    max-width: 740px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
  }

  .hero__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 2.25rem;
  }

  .hero__newsletter {
    width: 100%;
    max-width: 620px;
  }

  /* ── Articles ── */
  .articles {
    padding: 3.5rem 0;
  }

  .articles__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-text-primary);
  }

  .articles__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin: 0;
  }

  .articles__count {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .articles__empty {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .bottom-newsletter {
    padding: 2rem 0 4rem;
  }
</style>
