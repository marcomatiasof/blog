---
/**
 * ArticleCard.astro
 * Card component for article listings on the home/index pages.
 */
import { formatDate, useTranslations } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/constants';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: SupportedLocale;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const formattedDate = formatDate(post.data.date, lang);
---

<article class="card">
  {post.data.image && (
    <a href={`/${lang}/${post.data.slug}/`} class="card__image-link" tabindex="-1" aria-hidden="true">
      <div class="card__image-wrapper">
        <Image
          src={post.data.image}
          alt={post.data.title}
          loading="lazy"
          decoding="async"
          class="card__image"
          width={640}
          height={360}
        />
      </div>
    </a>
  )}

  <div class="card__body">
    {post.data.tags.length > 0 && (
      <div class="card__tags">
        {post.data.tags.slice(0, 3).map((tag) => (
          <span class="card__tag">{tag}</span>
        ))}
      </div>
    )}

    <h2 class="card__title">
      <a href={`/${lang}/${post.data.slug}/`} class="card__title-link">
        {post.data.title}
      </a>
    </h2>

    <p class="card__description">{post.data.description}</p>

    <div class="card__meta">
      <time class="card__date" datetime={post.data.date.toISOString()}>
        {formattedDate}
      </time>
      <span class="card__author">{t('article.by')} {post.data.author}</span>
    </div>

    <a href={`/${lang}/${post.data.slug}/`} class="card__cta" aria-label={`${t('article.readmore')} - ${post.data.title}`}>
      {t('article.readmore')}
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</article>

<style>
  .card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s, border-color 0.25s;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }

  .card__image-link {
    display: block;
  }

  .card__image-wrapper {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-secondary);
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .card__image {
    transform: scale(1.04);
  }

  .card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.75rem;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .card__tag {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .card__title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .card__title-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .card__title-link:hover {
    color: var(--color-accent);
  }

  .card__description {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .card__date {
    font-weight: 500;
  }

  .card__author {
    font-weight: 400;
  }

  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: gap 0.2s, color 0.2s;
    margin-top: 0.25rem;
  }

  .card__cta:hover {
    gap: 0.625rem;
    color: var(--color-accent-hover);
  }
</style>
