---
/**
 * NewsletterBox.astro
 * High-converting, non-intrusive newsletter subscription box (James Clear / Zen Habits style).
 */
import { useTranslations } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/constants';

interface Props {
  lang: SupportedLocale;
  variant?: 'hero' | 'inline' | 'card';
}

const { lang, variant = 'inline' } = Astro.props;
const t = useTranslations(lang);
---

<div class={`newsletter-box newsletter-box--${variant}`}>
  <div class="newsletter-box__inner">
    <div class="newsletter-box__header">
      <div class="newsletter-box__badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span>Newsletter</span>
      </div>
      <h2 class="newsletter-box__title">{t('newsletter.title')}</h2>
      <p class="newsletter-box__subtitle">{t('newsletter.subtitle')}</p>
    </div>

    <form class="newsletter-box__form" action="#" method="POST" onsubmit="event.preventDefault(); alert('Obrigado! Seu e-mail foi cadastrado.');">
      <div class="newsletter-box__input-wrap">
        <input
          type="email"
          name="email"
          required
          placeholder={t('newsletter.placeholder')}
          class="newsletter-box__input"
        />
        <button type="submit" class="newsletter-box__button">
          <span>{t('newsletter.button')}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      <p class="newsletter-box__disclaimer">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
          <path d="M5 8L7 10L11 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        {t('newsletter.disclaimer')}
      </p>
    </form>
  </div>
</div>

<style>
  .newsletter-box {
    width: 100%;
    margin: 2.5rem 0;
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, #fafaf9 0%, #f5f5f4 100%);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    position: relative;
    min-height: 250px;
  }

  .newsletter-box--hero {
    margin: 0;
    background: #ffffff;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    min-height: 280px;
  }

  .newsletter-box--card {
    background: var(--color-accent-light);
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .newsletter-box__inner {
    padding: 2.25rem 2rem;
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-box__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .newsletter-box__title {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.25;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .newsletter-box__subtitle {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .newsletter-box__form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .newsletter-box__input-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 540px) {
    .newsletter-box__input-wrap {
      flex-direction: row;
    }
  }

  .newsletter-box__input {
    flex: 1;
    padding: 0.875rem 1.25rem;
    font-size: 0.95rem;
    font-family: var(--font-sans);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #ffffff;
    color: var(--color-text-primary);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .newsletter-box__input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  .newsletter-box__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    font-size: 0.925rem;
    font-weight: 700;
    font-family: var(--font-sans);
    color: #ffffff;
    background: var(--color-text-primary);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    white-space: nowrap;
  }

  .newsletter-box__button:hover {
    background: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
  }

  .newsletter-box__disclaimer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    font-size: 0.775rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }
</style>
