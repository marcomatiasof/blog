---
/**
 * BaseLayout.astro
 * The root layout for every page in the blog.
 * Handles: SEO meta, hreflang, Open Graph, AdSense (async/non-blocking), fonts.
 */
interface Props {
  title: string;
  description: string;
  lang: string;
  image?: string;
  /** Pass translationKey for article pages — enables hreflang generation */
  hreflangAlternates?: Array<{ hreflang: string; href: string }>;
  /** Canonical URL for this page */
  canonicalUrl?: string;
}

const {
  title,
  description,
  lang,
  image = '/images/og-default.jpg',
  hreflangAlternates = [],
  canonicalUrl,
} = Astro.props;

const SITE_NAME = 'TechFlow Blog';
const SITE_URL = 'https://yourblog.com';
const ogImage = image.startsWith('http') ? image : `${SITE_URL}${image}`;
const canonical = canonicalUrl ?? Astro.url.href;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Hreflang for i18n SEO -->
    {hreflangAlternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${SITE_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts: Inter — preconnect first to avoid render blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Critical CSS inline to avoid render blocking -->
    <style>
      :root {
        --color-bg: #ffffff;
        --color-bg-secondary: #f8fafc;
        --color-bg-card: #ffffff;
        --color-text-primary: #0f172a;
        --color-text-secondary: #475569;
        --color-text-muted: #94a3b8;
        --color-accent: #6366f1;
        --color-accent-hover: #4f46e5;
        --color-accent-light: #eef2ff;
        --color-border: #e2e8f0;
        --color-border-subtle: #f1f5f9;
        --color-success: #10b981;
        --color-code-bg: #f1f5f9;
        --color-code-text: #334155;
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 16px;
        --radius-xl: 24px;
        --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.07), 0 1px 2px -1px rgb(0 0 0 / 0.07);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.07), 0 2px 4px -2px rgb(0 0 0 / 0.07);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.07), 0 4px 6px -4px rgb(0 0 0 / 0.07);
        --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.08), 0 8px 10px -6px rgb(0 0 0 / 0.08);
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: 'Fira Code', 'Cascadia Code', 'JetBrains Mono', monospace;
        --max-width: 1200px;
        --content-width: 740px;
        --header-height: 68px;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

      body {
        font-family: var(--font-sans);
        background-color: var(--color-bg);
        color: var(--color-text-primary);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      main { flex: 1; }

      img { max-width: 100%; height: auto; display: block; }

      a { color: var(--color-accent); text-decoration: none; transition: color 0.2s; }
      a:hover { color: var(--color-accent-hover); }

      /* Prevent layout shift from AdSense slots */
      .adsense-slot {
        min-height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-bg-secondary);
        border: 1px dashed var(--color-border);
        border-radius: var(--radius-md);
        color: var(--color-text-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }
    </style>

    <!--
      Google AdSense Auto Ads
      IMPORTANT: Load async + defer to NEVER block rendering (Core Web Vitals).
      Replace "ca-pub-XXXXXXXXXX" with your publisher ID when you get it.
      Currently commented out — uncomment when AdSense account is ready.
    -->
    <!--
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX"
      crossorigin="anonymous"
    ></script>
    -->
  </head>

  <body>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />

    <!-- Global styles loaded after paint — does not block LCP -->
    <style is:global>
      /* Typography */
      h1, h2, h3, h4, h5, h6 {
        font-weight: 700;
        line-height: 1.25;
        color: var(--color-text-primary);
        letter-spacing: -0.02em;
      }

      h1 { font-size: clamp(1.875rem, 4vw, 2.75rem); margin-bottom: 1rem; }
      h2 { font-size: clamp(1.375rem, 3vw, 1.875rem); margin-bottom: 0.75rem; margin-top: 2.5rem; }
      h3 { font-size: clamp(1.125rem, 2.5vw, 1.375rem); margin-bottom: 0.5rem; margin-top: 2rem; }

      p { margin-bottom: 1.25rem; color: var(--color-text-secondary); line-height: 1.75; }

      /* Article prose styles */
      .prose {
        max-width: var(--content-width);
        margin: 0 auto;
      }

      .prose ul, .prose ol {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
        color: var(--color-text-secondary);
      }

      .prose li { margin-bottom: 0.5rem; line-height: 1.7; }

      .prose code {
        font-family: var(--font-mono);
        font-size: 0.875em;
        background: var(--color-code-bg);
        color: var(--color-accent);
        padding: 0.15em 0.45em;
        border-radius: 4px;
        font-weight: 500;
      }

      .prose pre {
        background: #0f172a;
        color: #e2e8f0;
        padding: 1.25rem 1.5rem;
        border-radius: var(--radius-md);
        overflow-x: auto;
        margin-bottom: 1.5rem;
        border: 1px solid #1e293b;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        line-height: 1.7;
      }

      .prose pre code {
        background: none;
        color: inherit;
        padding: 0;
        border-radius: 0;
        font-weight: 400;
      }

      .prose blockquote {
        border-left: 4px solid var(--color-accent);
        padding: 0.75rem 1.25rem;
        background: var(--color-accent-light);
        border-radius: 0 var(--radius-md) var(--radius-md) 0;
        margin: 1.5rem 0;
        color: var(--color-text-secondary);
        font-style: italic;
      }

      .prose hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 2.5rem 0;
      }

      .prose a {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .prose img {
        border-radius: var(--radius-lg);
        margin: 2rem auto;
        box-shadow: var(--shadow-lg);
      }

      /* Utility */
      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
      }

      /* Focus styles for accessibility */
      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: 3px;
      }
    </style>
  </body>
</html>
