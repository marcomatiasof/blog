---
/**
 * ReadingProgressBar.astro
 * Thin, smooth progress bar at the top of article pages indicating reading progress.
 */
---

<div id="reading-progress-bar" class="progress-bar" aria-hidden="true"></div>

<style>
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: linear-gradient(90deg, var(--color-accent) 0%, #3b82f6 100%);
    z-index: 1000;
    transition: width 0.1s ease-out;
  }
</style>

<script>
  const progressBar = document.getElementById('reading-progress-bar');

  if (progressBar) {
    const updateProgress = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = height > 0 ? (scrollTop / height) * 100 : 0;
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }
</script>
