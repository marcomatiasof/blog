---
/**
 * src/pages/[lang]/index.astro
 * Home page for each locale: /en/, /pt/, /es/
 * Incorporates James Clear editorial layout, featured post spotlight, and intuitive blog features.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import NotificationToast from '../../components/NotificationToast.astro';
import { getCollection } from 'astro:content';
import { useTranslations, formatDate } from '../../i18n/utils';
import { SUPPORTED_LOCALES, SITE_URL, type SupportedLocale } from '../../i18n/constants';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);

const allPosts = await getCollection('blog', (post) => {
  return post.data.locale === lang && !post.data.draft;
});

allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPost = allPosts.length > 0 ? allPosts[0] : null;
const remainingPosts = allPosts.length > 1 ? allPosts.slice(1) : [];

// Hreflang for home pages
const hreflangAlternates = [
  ...SUPPORTED_LOCALES.map((locale) => ({
    hreflang: locale,
    href: `${SITE_URL}/${locale}/`,
  })),
  { hreflang: 'x-default', href: `${SITE_URL}/en/` },
];

const featuredReadTime = featuredPost?.body
  ? Math.max(1, Math.ceil(featuredPost.body.split(/\s+/).length / 200))
  : 4;
---

<BaseLayout
  title={t('nav.home')}
  description={t('site.tagline')}
  lang={lang}
  hreflangAlternates={hreflangAlternates}
  canonicalUrl={`${SITE_URL}/${lang}/`}
>
  <Header slot="header" lang={lang} />
  <NotificationToast lang={lang} />

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <h1 class="hero__title">{t('home.hero.title')}</h1>
        <p class="hero__subtitle">{t('home.hero.subtitle')}</p>
        
        <!-- Hero Newsletter Subscription Box -->
        <div class="hero__newsletter">
          <NewsletterBox lang={lang} variant="hero" />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Post Spotlight Section -->
  {featuredPost && (
    <section class="featured-section">
      <div class="container">
        <div class="featured-badge">
          <span>✨ Post em Destaque</span>
        </div>
        <article class="featured-card">
          {featuredPost.data.image && (
            <a href={`/${lang}/${featuredPost.data.slug}/`} class="featured-card__image-link">
              <div class="featured-card__image-wrapper">
                <Image
                  src={featuredPost.data.image}
                  alt={featuredPost.data.title}
                  loading="eager"
                  decoding="async"
                  class="featured-card__image"
                  width={960}
                  height={540}
                />
              </div>
            </a>
          )}
          <div class="featured-card__body">
            {featuredPost.data.tags.length > 0 && (
              <div class="featured-card__tags">
                {featuredPost.data.tags.map((tag) => (
                  <span class="featured-card__tag">{tag}</span>
                ))}
              </div>
            )}
            <h2 class="featured-card__title">
              <a href={`/${lang}/${featuredPost.data.slug}/`}>
                {featuredPost.data.title}
              </a>
            </h2>
            <p class="featured-card__description">{featuredPost.data.description}</p>
            
            <div class="featured-card__meta">
              <div class="featured-card__meta-left">
                <time datetime={featuredPost.data.date.toISOString()}>
                  {formatDate(featuredPost.data.date, lang)}
                </time>
                <span class="featured-card__dot">•</span>
                <span class="featured-card__readtime">
                  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/>
                    <polyline points="8 4 8 8 11 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  {featuredReadTime} min de leitura
                </span>
              </div>
              <span class="featured-card__author">{t('article.by')} {featuredPost.data.author}</span>
            </div>

            <a href={`/${lang}/${featuredPost.data.slug}/`} class="featured-card__cta">
              {t('article.readmore')}
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </article>
      </div>
    </section>
  )}

  <!-- AdSense Slot Banner -->
  <div class="container" style="margin-top: 2rem;">
    <div class="adsense-slot" aria-hidden="true">Advertisement</div>
  </div>

  <!-- Articles Grid Section -->
  <section class="articles" id="articles">
    <div class="container">
      <div class="articles__header">
        <h2 class="articles__heading">Últimas Publicações</h2>
        <span class="articles__count">{allPosts.length} {allPosts.length === 1 ? 'artigo' : 'artigos'}</span>
      </div>

      {allPosts.length > 0 ? (
        <div class="articles__grid">
          {(remainingPosts.length > 0 ? remainingPosts : allPosts).map((post) => (
            <ArticleCard post={post} lang={lang} />
          ))}
        </div>
      ) : (
        <p class="articles__empty">Nenhum artigo publicado no momento.</p>
      )}
    </div>
  </section>

  <!-- Bottom Newsletter CTA Section -->
  <section class="bottom-newsletter">
    <div class="container">
      <NewsletterBox lang={lang} variant="card" />
    </div>
  </section>

  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 4rem 0 3.5rem;
    background: linear-gradient(180deg, #f5f5f0 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__content {
    max-width: 740px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
  }

  .hero__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 2.25rem;
  }

  .hero__newsletter {
    width: 100%;
    max-width: 620px;
  }

  /* ── Featured Section Spotlight ── */
  .featured-section {
    padding: 3.5rem 0 1rem;
  }

  .featured-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .featured-card:hover {
    box-shadow: var(--shadow-xl);
    border-color: var(--color-accent);
  }

  .featured-card__image-link {
    display: block;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
  }

  .featured-card__image-wrapper {
    width: 100%;
    height: 100%;
    background: var(--color-bg-secondary);
  }

  .featured-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .featured-card:hover .featured-card__image {
    transform: scale(1.03);
  }

  .featured-card__body {
    padding: 2.5rem 2.5rem 2.5rem 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-card__tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }

  .featured-card__tag {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }

  .featured-card__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .featured-card__title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .featured-card__title a:hover {
    color: var(--color-accent);
  }

  .featured-card__description {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0 0 1.5rem;
  }

  .featured-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
    margin-bottom: 1.5rem;
  }

  .featured-card__meta-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .featured-card__dot {
    color: var(--color-border);
  }

  .featured-card__readtime {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
  }

  .featured-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    transition: gap 0.2s, color 0.2s;
  }

  .featured-card__cta:hover {
    gap: 0.75rem;
    color: var(--color-accent-hover);
  }

  /* ── Articles ── */
  .articles {
    padding: 3.5rem 0;
  }

  .articles__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-text-primary);
  }

  .articles__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin: 0;
  }

  .articles__count {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .articles__empty {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .bottom-newsletter {
    padding: 2rem 0 4rem;
  }

  @media (max-width: 900px) {
    .featured-card {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .featured-card__body {
      padding: 1.5rem;
    }
    .featured-card__image-link {
      min-height: 240px;
    }
  }
</style>
