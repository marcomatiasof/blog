---
/**
 * BaseLayout.astro
 * The root layout for every page in the blog.
 * Incorporates James Clear (typography & newsletter focus), Zen Habits (zen minimalism),
 * and The Points Guy (clean card metadata & AdSense conversion optimization).
 */
import type { SupportedLocale } from '../i18n/constants';
import { SITE_NAME, SITE_URL } from '../i18n/constants';

interface Props {
  title: string;
  description: string;
  lang: SupportedLocale;
  image?: string;
  hreflangAlternates?: Array<{ hreflang: string; href: string }>;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  author?: string;
  articleDate?: Date;
}

const {
  title,
  description,
  lang,
  image = '/images/og-default.jpg',
  hreflangAlternates = [],
  canonicalUrl,
  type = 'website',
  author = SITE_NAME,
  articleDate,
} = Astro.props;

const ogImage = image.startsWith('http') ? image : `${SITE_URL}${image}`;
const canonical = canonicalUrl ?? Astro.url.href;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={author} />

    <!-- Hreflang for i18n SEO -->
    {hreflangAlternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={`${title} | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${SITE_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(
      type === 'article' ? {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "image": [ogImage],
        "datePublished": articleDate ? articleDate.toISOString() : undefined,
        "author": [{
          "@type": "Person",
          "name": author
        }]
      } : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": SITE_NAME,
        "url": SITE_URL
      }
    )} />

    <!-- Google Fonts: Inter (Sans) + Newsreader (Editorial Serif for James Clear feel) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />

    <!-- Critical Design System Inline CSS -->
    <style>
      :root {
        /* Palette inspired by James Clear & Zen Habits (Warm, Serene, High-Contrast) */
        --color-bg: #fbfbf9;
        --color-bg-secondary: #f4f4f0;
        --color-bg-card: #ffffff;
        --color-text-primary: #18181b;
        --color-text-secondary: #44403c;
        --color-text-muted: #57534e;
        --color-accent: #4f46e5;
        --color-accent-hover: #4338ca;
        --color-accent-light: #eef2ff;
        --color-border: #e7e5e4;
        --color-border-subtle: #f5f5f4;
        --color-code-bg: #f4f4f0;
        
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-serif: 'Newsreader', Georgia, serif;
        
        --max-width: 1140px;
        --content-width: 700px;
        --header-height: 72px;

        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 16px;
        --radius-xl: 24px;

        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow-md: 0 4px 12px -2px rgb(0 0 0 / 0.06);
        --shadow-lg: 0 12px 24px -4px rgb(0 0 0 / 0.08);
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

      body {
        font-family: var(--font-sans);
        background-color: var(--color-bg);
        color: var(--color-text-primary);
        line-height: 1.65;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      main { flex: 1; }

      img { max-width: 100%; height: auto; display: block; }

      a { color: var(--color-accent); text-decoration: none; transition: color 0.2s; }
      a:hover { color: var(--color-accent-hover); }

      /* AdSense Placeholder Styles */
      .adsense-slot {
        min-height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-bg-secondary);
        border: 1px dashed var(--color-border);
        border-radius: var(--radius-md);
        color: var(--color-text-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }
    </style>
  </head>

  <body>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />

    <!-- Global Typography & Article Styles -->
    <style is:global>
      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-serif);
        font-weight: 700;
        line-height: 1.2;
        color: var(--color-text-primary);
        letter-spacing: -0.02em;
      }

      h1 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1.25rem; }
      h2 { font-size: clamp(1.5rem, 3vw, 2.125rem); margin-bottom: 1rem; margin-top: 2.75rem; }
      h3 { font-size: clamp(1.25rem, 2.5vw, 1.5rem); margin-bottom: 0.75rem; margin-top: 2.25rem; }

      p { margin-bottom: 1.35rem; color: var(--color-text-secondary); font-size: 1.075rem; line-height: 1.8; }

      /* Editorial Prose - James Clear & Zen Habits Reading Experience */
      .prose {
        max-width: var(--content-width);
        margin: 0 auto;
        font-size: 1.1rem;
        line-height: 1.85;
      }

      .prose p {
        margin-bottom: 1.5rem;
        color: #292524;
      }

      .prose ul, .prose ol {
        margin-bottom: 1.5rem;
        padding-left: 1.75rem;
        color: #292524;
      }

      .prose li {
        margin-bottom: 0.625rem;
        line-height: 1.8;
      }

      .prose blockquote {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        line-height: 1.6;
        border-left: 3px solid var(--color-accent);
        padding: 0.75rem 1.5rem;
        margin: 2rem 0;
        color: #44403c;
        background: #f4f4f0;
        border-radius: 0 var(--radius-md) var(--radius-md) 0;
        font-style: italic;
      }

      .prose hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 3rem 0;
      }

      .prose a {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 3px;
        font-weight: 500;
      }

      .prose img {
        border-radius: var(--radius-lg);
        margin: 2.5rem auto;
        box-shadow: var(--shadow-md);
      }

      /* Container Utility */
      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: 4px;
      }
    </style>
  </body>
</html>
