---
/**
 * NotificationToast.astro
 * Professional floating notification prompt inspired by top news portals.
 */
import { useTranslations } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/constants';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;

const promptText = {
  pt: 'Deseja receber as últimas novidades e análises exclusivas do TechFlow?',
  en: 'Would you like to receive the latest stories and exclusive insights from TechFlow?',
  es: '¿Deseas recibir las últimas novedades y análisis exclusivos de TechFlow?',
}[lang];

const yesText = { pt: 'SIM', en: 'YES', es: 'SÍ' }[lang];
const noText = { pt: 'NÃO', en: 'NO', es: 'NO' }[lang];
---

<div id="notification-toast" class="toast" role="dialog" aria-live="polite" hidden>
  <div class="toast__inner">
    <div class="toast__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="toast__body">
      <p class="toast__text">{promptText}</p>
      <div class="toast__actions">
        <button type="button" id="toast-no-btn" class="toast__btn toast__btn--no">
          {noText}
        </button>
        <button type="button" id="toast-yes-btn" class="toast__btn toast__btn--yes">
          {yesText}
        </button>
      </div>
    </div>
    <button type="button" id="toast-close-btn" class="toast__close" aria-label="Close notification">
      ✕
    </button>
  </div>
</div>

<style>
  .toast {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 99;
    max-width: 420px;
    width: calc(100vw - 3rem);
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
    animation: toastSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes toastSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .toast__inner {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1.125rem;
    position: relative;
  }

  .toast__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: var(--color-accent-light);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toast__body {
    flex: 1;
  }

  .toast__text {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.45;
    margin: 0 0 0.875rem;
  }

  .toast__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.625rem;
  }

  .toast__btn {
    padding: 0.375rem 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    font-family: inherit;
  }

  .toast__btn--no {
    background: transparent;
    color: var(--color-text-secondary);
  }

  .toast__btn--no:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
  }

  .toast__btn--yes {
    background: var(--color-accent);
    color: white;
  }

  .toast__btn--yes:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }

  .toast__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: none;
    border: none;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }

  .toast__close:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 480px) {
    .toast {
      bottom: 1rem;
      right: 1rem;
      left: 1rem;
      width: auto;
    }
  }
</style>

<script>
  const toast = document.getElementById('notification-toast');
  const yesBtn = document.getElementById('toast-yes-btn');
  const noBtn = document.getElementById('toast-no-btn');
  const closeBtn = document.getElementById('toast-close-btn');

  if (toast) {
    const dismissed = localStorage.getItem('tf_toast_dismissed');
    if (!dismissed) {
      setTimeout(() => {
        toast.removeAttribute('hidden');
      }, 2500);
    }

    const dismissToast = () => {
      toast.setAttribute('hidden', '');
      localStorage.setItem('tf_toast_dismissed', 'true');
    };

    yesBtn?.addEventListener('click', () => {
      dismissToast();
      const newsletter = document.querySelector('.newsletter-box');
      if (newsletter) {
        newsletter.scrollIntoView({ behavior: 'smooth' });
        const input = newsletter.querySelector('input[type="email"]') as HTMLInputElement;
        if (input) input.focus();
      }
    });

    noBtn?.addEventListener('click', dismissToast);
    closeBtn?.addEventListener('click', dismissToast);
  }
</script>
