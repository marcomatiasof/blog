---
/**
 * src/pages/[lang]/autor/[slug].astro
 * Author profile page following Google E-E-A-T guidelines.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import NewsletterBox from '../../../components/NewsletterBox.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';
import { SUPPORTED_LOCALES, SITE_URL, type SupportedLocale } from '../../../i18n/constants';

export function slugifyAuthor(author: string) {
  return author
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');
}

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', (post) => !post.data.draft);
  const authorsSet = new Set<string>();

  allPosts.forEach((post) => {
    if (post.data.author) {
      authorsSet.add(post.data.author);
    }
  });

  const paths = [];
  for (const lang of SUPPORTED_LOCALES) {
    for (const author of Array.from(authorsSet)) {
      paths.push({
        params: { lang, slug: slugifyAuthor(author) },
        props: { authorName: author },
      });
    }
  }
  return paths;
}

const { authorName } = Astro.props;
const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);

// Fetch articles written by this author in current language
const authorPosts = await getCollection('blog', (post) => {
  return (
    post.data.locale === lang &&
    !post.data.draft &&
    slugifyAuthor(post.data.author) === slugifyAuthor(authorName)
  );
});

authorPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const firstPostWithDetails = authorPosts.find((p) => p.data.authorRole || p.data.authorAvatar);
const authorRole = firstPostWithDetails?.data.authorRole || 'Jornalista & Colunista Editorial';

const hreflangAlternates = SUPPORTED_LOCALES.map((locale) => ({
  hreflang: locale,
  href: `${SITE_URL}/${locale}/autor/${slugifyAuthor(authorName)}/`,
}));
---

<BaseLayout
  title={`${authorName} — Autor em TechFlow`}
  description={`Confira o perfil, biografia e últimas reportagens publicadas por ${authorName}.`}
  lang={lang}
  hreflangAlternates={hreflangAlternates}
  canonicalUrl={`${SITE_URL}/${lang}/autor/${slugifyAuthor(authorName)}/`}
>
  <Header slot="header" lang={lang} />

  <!-- Author Header Spotlight -->
  <section class="author-hero">
    <div class="container">
      <div class="author-card">
        <div class="author-avatar">
          {authorName.charAt(0).toUpperCase()}
        </div>
        <div class="author-info">
          <span class="author-badge">Perfil Editorial</span>
          <h1 class="author-name">{authorName}</h1>
          <p class="author-role">{authorRole}</p>
          <p class="author-bio">
            Jornalista e pesquisador cobrindo temas estratégicos de produtividade, desenvolvimento pessoal, tecnologia e atualidades no TechFlow.
          </p>
          <div class="author-stats">
            <span>📚 {authorPosts.length} {authorPosts.length === 1 ? 'matéria publicada' : 'matérias publicadas'}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Author Articles Grid -->
  <section class="author-articles">
    <div class="container">
      <div class="articles__header">
        <h2 class="articles__heading">Matérias Publicadas por {authorName}</h2>
      </div>

      {authorPosts.length > 0 ? (
        <div class="articles__grid">
          {authorPosts.map((post) => (
            <ArticleCard post={post} lang={lang} />
          ))}
        </div>
      ) : (
        <p class="articles__empty">Nenhum artigo publicado por este autor neste idioma.</p>
      )}
    </div>
  </section>

  <section class="bottom-newsletter">
    <div class="container">
      <NewsletterBox lang={lang} variant="card" />
    </div>
  </section>

  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
  .author-hero {
    padding: 3.5rem 0;
    background: linear-gradient(180deg, var(--color-bg-secondary) 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .author-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 760px;
    margin: 0 auto;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .author-avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: var(--color-accent);
    color: white;
    font-size: 2.5rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .author-badge {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .author-name {
    font-family: var(--font-serif);
    font-size: 1.875rem;
    font-weight: 800;
    margin: 0;
    color: var(--color-text-primary);
  }

  .author-role {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin: 0 0 0.5rem;
  }

  .author-bio {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .author-stats {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .author-articles {
    padding: 3.5rem 0;
  }

  .articles__header {
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-text-primary);
  }

  .articles__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin: 0;
  }

  .articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .articles__empty {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .bottom-newsletter {
    padding: 2rem 0 4rem;
  }

  @media (max-width: 640px) {
    .author-card {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
    }
  }
</style>
