---
/**
 * LanguagePicker.astro
 * Shows a dropdown to switch between available language versions of the current content.
 * On article pages, switches to the translated article (via translationKey).
 * On home/listing pages, switches to the locale home.
 */
import { SUPPORTED_LOCALES, LOCALE_NAMES, LOCALE_FLAGS, type SupportedLocale } from '../i18n/constants';
import { getAlternates } from '../i18n/utils';
import { getCollection } from 'astro:content';

interface Props {
  currentLang: SupportedLocale;
  /** Pass only on article pages. Used to build links to translated versions. */
  translationKey?: string;
}

const { currentLang, translationKey } = Astro.props;

let langLinks: Record<SupportedLocale, string> = {
  en: '/en/',
  pt: '/pt/',
  es: '/es/',
};

// If we're on an article page, build links to the translated versions
if (translationKey) {
  const allPosts = await getCollection('blog');
  const alternates = getAlternates(translationKey, allPosts);
  for (const locale of SUPPORTED_LOCALES) {
    const alt = alternates[locale];
    if (alt) {
      langLinks[locale] = `/${locale}/${alt.slug}/`;
    } else {
      // If no translation exists for this locale, fall back to locale home
      langLinks[locale] = `/${locale}/`;
    }
  }
}
---

<div class="lang-picker" id="lang-picker">
  <button
    class="lang-picker__trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label="Select language"
    id="lang-picker-btn"
  >
    <span class="lang-picker__flag" aria-hidden="true">
      {LOCALE_FLAGS[currentLang]}
    </span>
    <span class="lang-picker__current">{LOCALE_NAMES[currentLang]}</span>
    <svg class="lang-picker__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <ul class="lang-picker__dropdown" role="listbox" aria-label="Select language" id="lang-picker-list">
    {SUPPORTED_LOCALES.map((locale) => (
      <li role="option" aria-selected={locale === currentLang}>
        <a
          href={langLinks[locale]}
          class:list={['lang-picker__option', { 'lang-picker__option--active': locale === currentLang }]}
          hreflang={locale}
          onclick={`document.cookie = 'preferred_locale=${locale};path=/;max-age=31536000;SameSite=Lax'`}
        >
          <span class="lang-picker__flag" aria-hidden="true">{LOCALE_FLAGS[locale]}</span>
          <span>{LOCALE_NAMES[locale]}</span>
          {locale === currentLang && (
            <svg class="lang-picker__check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8L6.5 11.5L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .lang-picker {
    position: relative;
  }

  .lang-picker__trigger {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    transition: all 0.2s;
    white-space: nowrap;
  }

  .lang-picker__trigger:hover {
    background: var(--color-border-subtle);
    border-color: var(--color-text-muted);
  }

  .lang-picker__chevron {
    color: var(--color-text-muted);
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  .lang-picker[aria-expanded="true"] .lang-picker__chevron,
  .lang-picker__trigger[aria-expanded="true"] .lang-picker__chevron {
    transform: rotate(180deg);
  }

  .lang-picker__flag {
    font-size: 1rem;
    line-height: 1;
  }

  .lang-picker__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 160px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xl);
    padding: 0.375rem;
    list-style: none;
    z-index: 100;
    animation: slideDown 0.15s ease-out;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .lang-picker__dropdown.is-open {
    display: block;
  }

  .lang-picker__option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    transition: background 0.15s;
    text-decoration: none;
  }

  .lang-picker__option:hover {
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
  }

  .lang-picker__option--active {
    color: var(--color-accent);
    background: var(--color-accent-light);
  }

  .lang-picker__check {
    margin-left: auto;
    color: var(--color-accent);
  }
</style>

<script>
  // Toggle dropdown open/close
  const picker = document.getElementById('lang-picker');
  const btn = document.getElementById('lang-picker-btn');
  const list = document.getElementById('lang-picker-list');

  if (btn && list && picker) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = list.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });

    // Close when clicking outside
    document.addEventListener('click', () => {
      list.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        list.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      }
    });
  }
</script>
