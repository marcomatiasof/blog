---
/**
 * src/pages/[lang]/[slug].astro
 * Individual article page template.
 * James Clear editorial reading experience + Zen Habits serene typography + AdSense & Newsletter placement.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations, getHreflangAlternates, formatDate } from '../../i18n/utils';
import { SUPPORTED_LOCALES, SITE_URL, LOCALE_NAMES, LOCALE_FLAGS, type SupportedLocale } from '../../i18n/constants';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', (post) => !post.data.draft);

  return allPosts.map((post) => ({
    params: {
      lang: post.data.locale,
      slug: post.data.slug,
    },
    props: { post, allPosts },
  }));
}

const { post, allPosts } = Astro.props;
const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);

const { Content, headings } = await render(post);

const hreflangAlternates = getHreflangAlternates(post.data.translationKey, allPosts);
const formattedDate = formatDate(post.data.date, lang);
const canonicalUrl = `${SITE_URL}/${lang}/${post.data.slug}/`;

// Calculate estimated reading time
const wordCount = post.body ? post.body.split(/\s+/).length : 1200;
const readTimeMinutes = Math.max(1, Math.ceil(wordCount / 220));

// Build links to other translations of this article
const translationLinks = SUPPORTED_LOCALES
  .filter((locale) => locale !== lang)
  .map((locale) => {
    const alternate = hreflangAlternates.find(
      (a) => a.hreflang === locale
    );
    return alternate ? { locale, url: alternate.href } : null;
  })
  .filter(Boolean) as Array<{ locale: SupportedLocale; url: string }>;

// Related posts for "Leia também" (excluding current post)
const relatedPosts = allPosts
  .filter((p) => p.data.locale === lang && p.data.slug !== post.data.slug)
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  image={post.data.image}
  hreflangAlternates={hreflangAlternates}
  canonicalUrl={canonicalUrl}
>
  <Header slot="header" lang={lang} translationKey={post.data.translationKey} />

  <article class="article-page">
    <div class="container">
      <!-- Article Header -->
      <header class="article-header">
        {post.data.tags.length > 0 && (
          <div class="article-tags">
            {post.data.tags.map((tag) => (
              <span class="article-tag">{tag}</span>
            ))}
          </div>
        )}

        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>

        <div class="article-meta">
          <div class="article-meta__left">
            <time class="article-meta__item" datetime={post.data.date.toISOString()}>
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <rect x="2" y="3" width="12" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/>
                <path d="M2 6H14" stroke="currentColor" stroke-width="1.5"/>
                <path d="M5 1V4M11 1V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              {formattedDate}
            </time>
            
            <span class="article-meta__divider">•</span>
            
            <span class="article-meta__item">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/>
                <polyline points="8 4 8 8 11 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              {readTimeMinutes} {t('article.readTime')}
            </span>

            <span class="article-meta__divider">•</span>

            <span class="article-meta__item">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="5" r="3" stroke="currentColor" stroke-width="1.5"/>
                <path d="M2 14C2 11.2386 4.68629 9 8 9C11.3137 9 14 11.2386 14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              {t('article.by')} {post.data.author}
            </span>
          </div>

          {translationLinks.length > 0 && (
            <div class="article-meta__translations">
              <span class="article-meta__also">{t('article.alsoAvailableIn')}:</span>
              {translationLinks.map(({ locale, url }) => (
                <a href={url} class="article-meta__lang-link" hreflang={locale}>
                  {LOCALE_FLAGS[locale]} {LOCALE_NAMES[locale]}
                </a>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- AdSense Top Banner -->
      <div class="article-adsense adsense-slot" aria-hidden="true">Advertisement</div>

      <!-- Main Prose Content -->
      <div class="prose article-content">
        <Content />
      </div>

      <!-- In-Article Newsletter Subscription Box (James Clear / Zen Habits style) -->
      <div class="article-newsletter-wrap">
        <NewsletterBox lang={lang} variant="card" />
      </div>

      <!-- AdSense Bottom Banner -->
      <div class="article-adsense adsense-slot" aria-hidden="true">Advertisement</div>

      <!-- Related Posts Section (Leia também) -->
      {relatedPosts.length > 0 && (
        <section class="related-section">
          <h2 class="related-section__title">{t('article.readNext')}</h2>
          <div class="related-section__grid">
            {relatedPosts.map((relatedPost) => (
              <ArticleCard post={relatedPost} lang={lang} />
            ))}
          </div>
        </section>
      )}
    </div>
  </article>

  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
  .article-page {
    padding: 3.5rem 0 5rem;
  }

  /* ── Article Header ── */
  .article-header {
    max-width: var(--content-width);
    margin: 0 auto 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .article-tag {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(2.125rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin: 0;
  }

  .article-description {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
    border-left: 3px solid var(--color-accent);
    padding-left: 1.25rem;
    font-style: italic;
  }

  .article-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    margin-top: 0.5rem;
  }

  .article-meta__left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .article-meta__item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .article-meta__divider {
    color: var(--color-border);
    font-size: 0.85rem;
  }

  .article-meta__translations {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .article-meta__also {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .article-meta__lang-link {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .article-meta__lang-link:hover {
    background: var(--color-accent);
    color: white;
  }

  /* ── AdSense ── */
  .article-adsense {
    max-width: var(--content-width);
    margin: 2.5rem auto;
  }

  /* ── Content ── */
  .article-content {
    margin-bottom: 3.5rem;
  }

  .article-newsletter-wrap {
    max-width: var(--content-width);
    margin: 3.5rem auto;
  }

  /* ── Related Section (Leia Também) ── */
  .related-section {
    max-width: var(--max-width);
    margin: 4rem auto 0;
    padding-top: 3rem;
    border-top: 2px solid var(--color-text-primary);
  }

  .related-section__title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
  }

  .related-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
</style>
